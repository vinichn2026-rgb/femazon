// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  phone     String?
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  cart          Cart?
  wishlist      Wishlist?
  addresses     Address[]
  bookings      ServiceBooking[]
  vendorProfile VendorProfile?
  products      Product[] // Relation added since Product has vendorId
  wardrobeItems WardrobeItem[]
  notifications Notification[]
  reviews       Review[]
  partnerApplications PartnerApplication[]
  stylistProfile      StylistProfile?
  stylistBookings     StylistBooking[]
  stylistReviews      StylistReview[]
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  slug          String      @unique
  description   String?
  price         Int
  discountPrice Int?
  sku           String?
  image         String?
  images        String?     // Stored as JSON string
  category      String?
  subcategory   String?
  dressType     String?
  occasion      String?
  silhouette    String?
  flaggedForReview Boolean    @default(false)
  stock         Int         @default(0)
  sizes         String?     // Store as JSON or comma-separated string for SQLite compatibility
  colors        String?     // Store as JSON or comma-separated string for SQLite compatibility
  approvalStatus String     @default("APPROVED") // Auto-approved for backward compatibility
  rejectionReason String?   // Admin rejection reason / feedback
  readyToShip    Boolean    @default(true)
  deliveryDays   Int?
  brandName      String?    @default("Femazon Luxe")
  fabricCare     String?
  packageContains String?
  dispatchTimeline String   @default("Dispatched within 24-48 Hours")
  vendorId      Int?
  vendor        User?       @relation(fields: [vendorId], references: [id])
  categoryId    Int?
  categoryRel   Category?   @relation(fields: [categoryId], references: [id])
  subcategoryId Int?
  subcategoryRel Subcategory? @relation(fields: [subcategoryId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  colorVariants ColorVariant[]
  giftProduct   GiftProduct?
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int
  status        String      @default("PLACED")
  total         Int
  paymentMethod String      @default("COD")
  
  // Snapshot of delivery details
  shippingName  String?
  shippingPhone String?
  shippingAddr  String?
  shippingCity  String?
  shippingState String?
  shippingPin   String?

  // Delivery & Tracking
  dueDate       DateTime?
  deliveredOn   DateTime?
  remarks       String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int     @default(1)
  price     Int
  size      String?
  color     String?
  status    String  @default("PLACED")
  
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  size      String?
  color     String?
  
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, size, color]) // Prevent duplicates of same variant
}

model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  productId  Int
  
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId]) // Product can only be in wishlist once
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  basePrice   Int        @default(0)
  image       String?
  
  providers   Provider[]
  bookings    ServiceBooking[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reviews     Review[]
}

model Provider {
  id          Int      @id @default(autoincrement())
  name        String
  bio         String?
  rating      Float    @default(5.0)
  reviewCount Int      @default(0)
  image       String?
  
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  bookings    ServiceBooking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]
}

model ServiceBooking {
  id            Int      @id @default(autoincrement())
  userId        Int
  providerId    Int
  serviceId     Int
  
  date          String   // Storing as YYYY-MM-DD for simplicity
  time          String   // Storing as HH:MM AM/PM
  location      String?  // Service address / area
  customerName  String?  // Contact person name
  customerPhone String?  // Contact phone number
  notes         String?  // Special requests, family count, bridal details
  supporterName String?  // Internal supporter assigned by Femazon Admin
  duration      Int?     // Duration in hours
  status        String   @default("REQUEST_RECEIVED") // REQUEST_RECEIVED, UNDER_REVIEW, SUPPORTER_ASSIGNED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED
  total         Int
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VendorProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  businessName     String
  slug             String?  @unique
  ownerName        String?
  email            String?
  phone            String?
  address          String?
  businessCategory String?
  description      String?
  gstNumber        String?
  status           String   @default("PENDING") // Requires Admin approval
  
  // Automatic approval email tracking
  approvalEmailSent        Boolean   @default(false)
  approvalEmailSentAt      DateTime?
  approvalEmailError       String?

  // Password setup tracking
  passwordSetupCompleted   Boolean   @default(false)
  passwordSetupCompletedAt DateTime?
  
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  slug          String        @unique
  image         String?
  description   String?
  displayOrder  Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  categoryId   Int
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  image        String?
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@unique([categoryId, name])
}

model WardrobeItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  imageUrl  String
  category  String   // e.g., Top, Bottom, Outerwear, Shoes, Accessory
  color     String?
  brand     String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   // e.g., ORDER, BOOKING, VENDOR, SYSTEM
  isRead    Boolean  @default(false)
  link      String?  // Optional URL to redirect to when clicked
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id          Int      @id @default(autoincrement())
  userId      Int
  rating      Int      // 1-5 stars
  comment     String?
  
  // Target relations (nullable, only one is populated per review)
  productId   Int?
  serviceId   Int?
  providerId  Int?

  createdAt   DateTime @default(now())
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider    Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model ColorVariant {
  id           String          @id @default(cuid())
  productId    Int
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName    String          // e.g., "Wine Red", "Emerald Green"
  colorHexCode String?         // e.g., "#722F37", "#046307" (for color swatch picker circle)
  images       VariantImage[]  // Dedicated gallery for this color
  sizes        SizeInventory[] // Physical stock by size for this color
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([productId])
}

model VariantImage {
  id             String       @id @default(cuid())
  colorVariantId String
  colorVariant   ColorVariant @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)
  imageUrl       String       // Uploaded image path/URL
  isThumbnail    Boolean      @default(false)
  displayOrder   Int          @default(1)
  createdAt      DateTime     @default(now())

  @@index([colorVariantId])
}

model SizeInventory {
  id             String       @id @default(cuid())
  colorVariantId String
  colorVariant   ColorVariant @relation(fields: [colorVariantId], references: [id], onDelete: Cascade)
  size           String       // "XS", "S", "M", "L", "XL", "XXL", "Free Size"
  stockQty       Int          @default(0) // Physical in-stock count
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([colorVariantId, size])
  @@index([colorVariantId])
}


model PartnerApplication {
  id             Int      @id @default(autoincrement())
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String
  businessName   String?
  applicantType  String
  categories     String
  description    String?
  experience     String?
  location       String?
  serviceInfo    String?
  pricingInfo    String?
  portfolio      String?
  documents      String?
  status         String   @default("PENDING")
  notes          String?
  rejectionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([applicantType])
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  parentType  String
  description String?
  image       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StylistProfile {
  id                   Int              @id @default(autoincrement())
  userId               Int?             @unique
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug                 String           @unique
  fullName             String
  email                String
  phone                String
  profileImage         String?
  city                 String
  location             String
  preferredLocations   String?          // JSON array or comma-separated locations
  experience           String           // e.g. "6+ Years"
  experienceYears      Int              @default(0)
  bio                  String
  specializations      String           // JSON array of specializations
  portfolioImages      String?          // JSON array of image URLs
  socialLinks          String?          // JSON object { instagram, linkedin, website }
  consultationModes    String           // JSON array e.g. ["Online", "In-Person"]
  qualifications       String?
  availabilitySchedule String?          // e.g. "Mon - Sat, 10:00 AM - 7:00 PM"
  status               String           @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  rejectionReason      String?
  verified             Boolean          @default(false)
  featured             Boolean          @default(false)
  commissionRate       Float            @default(15.0)
  isActive             Boolean          @default(true)
  packages             StylistPackage[]
  bookings             StylistBooking[]
  reviews              StylistReview[]
  portfolios           StylistPortfolio[]
  availabilities       StylistAvailability[]
  applications         StylistApplication[]
  commissions          Commission[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status])
  @@index([city])
  @@index([featured])
}

model StylistPackage {
  id               Int              @id @default(autoincrement())
  stylistId        Int
  stylist          StylistProfile   @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  title            String
  packageType      String
  description      String
  price            Int
  duration         String
  includedServices String           // JSON array of included service items
  sessionsCount    Int              @default(1)
  deliveryMode     String           @default("Online & Offline") // Online, Offline, Online & Offline
  location         String?
  addOns           String?          // JSON array of { name: string, price: number }
  availability     String?
  images           String?          // JSON array of package image URLs
  isActive         Boolean          @default(true)
  bookings         StylistBooking[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([stylistId])
}

model StylistBooking {
  id              Int             @id @default(autoincrement())
  stylistId       Int
  stylist         StylistProfile  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  packageId       Int?
  package         StylistPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  userId          Int?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  bookingDate     String
  bookingTime     String
  deliveryMode    String          @default("Online")
  location        String?
  selectedAddOns  String?         // JSON array of { name: string, price: number }
  notes           String?
  totalAmount     Int
  commissionAmount Int            @default(0)
  stylistEarnings Int             @default(0)
  paymentStatus   String          @default("PENDING") // PENDING, PAID, PAY_AT_SESSION
  status          String          @default("PENDING") // PENDING, ACCEPTED, CONFIRMED, COMPLETED, REJECTED, CANCELLED
  commission      Commission?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([stylistId])
  @@index([userId])
  @@index([status])
}

model StylistReview {
  id              Int            @id @default(autoincrement())
  stylistId       Int
  stylist         StylistProfile @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  rating          Int
  comment         String?
  isComplaint     Boolean        @default(false)
  complaintStatus String         @default("NONE") // NONE, OPEN, RESOLVED, DISMISSED
  isVisible       Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@index([stylistId])
}

model StylistPortfolio {
  id           Int            @id @default(autoincrement())
  stylistId    Int
  stylist      StylistProfile @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  imageUrl     String
  caption      String?
  category     String?
  displayOrder Int            @default(1)
  createdAt    DateTime       @default(now())

  @@index([stylistId])
}

model StylistAvailability {
  id          Int            @id @default(autoincrement())
  stylistId   Int
  stylist     StylistProfile @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  dayOfWeek   String         // e.g. "Monday", "Saturday"
  startTime   String         // e.g. "10:00 AM"
  endTime     String         // e.g. "07:00 PM"
  mode        String         @default("Online & In-Person")
  isAvailable Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([stylistId])
}

model StylistApplication {
  id              Int            @id @default(autoincrement())
  stylistId       Int
  stylist         StylistProfile @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  status          String         @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED
  notes           String?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([stylistId])
  @@index([status])
}

model GiftCategory {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String        @unique
  occasion     String?
  description  String?
  image        String?
  isActive     Boolean       @default(true)
  giftProducts GiftProduct[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GiftProduct {
  id               Int           @id @default(autoincrement())
  productId        Int           @unique
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  giftCategoryId   Int?
  giftCategory     GiftCategory? @relation(fields: [giftCategoryId], references: [id], onDelete: SetNull)
  occasion         String?
  recipient        String?
  isPersonalizable Boolean       @default(true)
  allowsGiftWrap   Boolean       @default(true)
  allowsGiftCard   Boolean       @default(true)
  deliveryEstimate String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([giftCategoryId])
}

model Commission {
  id               Int             @id @default(autoincrement())
  stylistId        Int?
  stylist          StylistProfile? @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  bookingId        Int?            @unique
  booking          StylistBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  grossAmount      Int
  commissionRate   Float
  commissionAmount Int
  netPayout        Int
  status           String          @default("PENDING") // PENDING, SETTLED
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([stylistId])
  @@index([status])
}

model ProductMedia {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

