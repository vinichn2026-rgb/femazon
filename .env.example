# Database (Supabase / Postgres)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Email Provider Configuration (Resend, Google Apps Script, or SMTP)
EMAIL_PROVIDER="resend"
EMAIL_FROM="Femazon <onboarding@resend.dev>"
SUPPORT_EMAIL="support@femazon.com"

# 1. Recommended: Resend API Key (https://resend.com)
EMAIL_API_KEY="re_..."

# 2. Alternative: Google Apps Script Web App (Gmail API)
# Deploy Code.gs as Web App in https://script.google.com and paste exec URL below
GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_SCRIPT_SECRET=""

# 3. Alternative: SMTP (Optional)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
