# Database (Supabase / Postgres)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Email Provider Configuration ('google_script', 'brevo', 'resend', 'smtp')
EMAIL_PROVIDER="google_script"
EMAIL_FROM="Femazon <hello@femazon.com>"

# Google Apps Script Web App (Gmail API for OTP)
# Deploy Code.gs as Web App in https://script.google.com and paste exec URL below
GOOGLE_SCRIPT_URL=""
GOOGLE_SCRIPT_SECRET=""

# Alternative: Brevo API
BREVO_API_KEY=""

# Alternative: Resend API
# RESEND_API_KEY=""

# Alternative: SMTP
